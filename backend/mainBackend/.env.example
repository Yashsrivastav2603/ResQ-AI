# ---- required ----
# At least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-bytes

# ---- database ----
DB_URL=jdbc:postgresql://localhost:5432/resqai
DB_USERNAME=resqai
DB_PASSWORD=resqai

# ---- CORS: where your frontend runs ----
CORS_ORIGINS=https://res-q-ai-nine.vercel.app,http://localhost:5173,http://localhost:3000

# ---- geocoding (OpenStreetMap Nominatim: free, no key) ----
# Their usage policy requires a real contact address here.
GEOCODER_USER_AGENT=ResQ-AI/0.1 (you@example.com)

# ---- disaster news providers ----
# USGS, GDACS and NASA EONET need no key and are on by default.
# GNews: free tier key from https://gnews.io  (leave blank to disable)
GNEWS_API_KEY=
# ReliefWeb v2 requires a pre-approved appname since Nov 2025.
# Request one at https://apidoc.reliefweb.int/ then set it here.
RELIEFWEB_APPNAME=resqai
RELIEFWEB_ENABLED=true

# ---- optional: seed the first admin on an empty database ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
